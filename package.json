{
  "name": "laterwatch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "跨平台视频稍后再看侧边栏插件：聚合 B 站 / 抖音 / 本地视频，支持回收站式删除",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
